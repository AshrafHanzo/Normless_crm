# ==========================================================================
# Normless CRM — PRODUCTION .env template (VPS)
# Copy this to the project root as `.env` ON THE SERVER and fill real values.
# NEVER commit the real .env to git.
# ==========================================================================

NODE_ENV=production
PORT=5000

# --- Database: local PostgreSQL on the VPS ---
# Created in the deploy steps: user "normless", db "normless_crm".
DATABASE_URL=postgresql://normless:CHANGE_ME_DB_PASSWORD@localhost:5432/normless_crm
# Leave DB_CLIENT unset in production so the Postgres driver is used.
# DB_CLIENT=sqlite   <-- only for local offline dev

# --- Auth ---
# Generate a strong one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# --- Shopify (rotate this token; it was previously committed to git) ---
SHOPIFY_STORE_DOMAIN=uqcyff-my.myshopify.com
SHOPIFY_ACCESS_TOKEN=CHANGE_ME_SHOPIFY_TOKEN

# --- Email (Gmail app password; rotate the old one) ---
GMAIL_USER=normlessforgot@gmail.com
GMAIL_APP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD

# --- URLs (your live domain) ---
FRONTEND_URL=https://normless.store
CORS_ORIGIN=https://normless.store

# --- Optional: override the seeded owner admin (used by init-postgres.js) ---
# ADMIN_USERNAME=you@normless.store
# ADMIN_PASSWORD=change_me_strong
