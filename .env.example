# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=./server/db/crm.db

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Email Configuration (Gmail)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Shopify Configuration
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_PASSWORD=your_shopify_api_password
SHOPIFY_SHOP_NAME=your_shop_name

# Razorpay (Crewfit quote payment links)
# Test and Live are separate worlds at Razorpay: a Live key can't see a Test payment link,
# and a webhook registered under Test Mode never fires for Live payments. RAZORPAY_MODE
# picks which set below is used — keys and webhook secret always come from the same mode.
# It is explicit (not derived from NODE_ENV) so deploying can't silently charge real cards.
RAZORPAY_MODE=test

RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=your_test_key_secret
RAZORPAY_TEST_WEBHOOK_SECRET=your_test_webhook_secret

RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=your_live_key_secret
RAZORPAY_LIVE_WEBHOOK_SECRET=your_live_webhook_secret

RAZORPAY_MODE=test

# CORS
CORS_ORIGIN=http://localhost:5173

# Embroidery converter (embroidery-service/, see its INTEGRATION.md).
# Any long random string; the service and the CRM just have to agree. Never sent to the browser.
EMB_API_KEY=change-me-to-a-long-random-string
# Where the converter listens. Localhost only — it is not exposed to the internet.
EMB_SERVICE_URL=http://127.0.0.1:8090
